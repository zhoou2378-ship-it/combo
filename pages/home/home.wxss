.container {
  min-height: 100vh;
  background: #0a0a0a;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.header {
  padding-top: 80rpx;
  padding-bottom: 48rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2rpx;
}

.list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding-bottom: 120rpx;
}

.history-link {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
  letter-spacing: 2rpx;
  text-align: center;
  padding: 16rpx 32rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 100rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
}
