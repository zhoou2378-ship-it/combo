.container {
  min-height: 100vh;
  background: #0a0a0a;
  padding: 0 32rpx;
}

/* 指标汇总 */
.metrics {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 28rpx 0;
  margin-top: 16rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.metric-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.metric-key {
  font-size: 20rpx;
  color: rgba(255,255,255,0.35);
  letter-spacing: 1rpx;
}

.metric-sep {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.08);
}

.header {
  padding: 80rpx 0 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.35);
  letter-spacing: 2rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.record-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.emotion-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-emotion {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.record-meta {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.record-percent {
  font-family: 'Courier New', monospace;
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
}

.record-combo {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
  font-family: 'Courier New', monospace;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.5);
}

.empty-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.25);
  margin-bottom: 48rpx;
}

.btn-start {
  background: #fff;
  color: #000;
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  border-radius: 100rpx;
  padding: 24rpx 64rpx;
  border: none;
}
