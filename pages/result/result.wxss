.container {
  min-height: 100vh;
  background: #0a0a0a;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx 60rpx;
  box-sizing: border-box;
}

.emotion-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 48rpx;
  animation: bounceIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes bounceIn {
  0%   { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.percent {
  font-size: 120rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1;
  text-shadow: 0 0 60rpx rgba(255,255,255,0.15);
}

.label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.4);
  letter-spacing: 4rpx;
  margin-top: 12rpx;
  margin-bottom: 60rpx;
}

.stats {
  display: flex;
  align-items: center;
  gap: 48rpx;
  margin-bottom: 80rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.stat-key {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  letter-spacing: 2rpx;
}

.stat-sep {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.1);
}

/* 主按钮横排 */
.actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

/* 再来一次 */
.btn-primary {
  flex: 1;
  background: #fff;
  color: #000;
  font-weight: 700;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  border-radius: 100rpx;
  padding: 28rpx 0;
  border: none;
  line-height: 1;
}

/* 分享成绩 */
.btn-share {
  flex: 1;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.85);
  font-weight: 600;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  border-radius: 100rpx;
  padding: 28rpx 0;
  border: none;
  line-height: 1;
}

/* 底部幽灵按钮 */
.btn-ghost {
  background: transparent;
  color: rgba(255,255,255,0.3);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  border: none;
  padding: 16rpx 0;
  margin-top: 8rpx;
}
