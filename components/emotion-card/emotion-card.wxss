.card {
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 240rpx;
  box-sizing: border-box;
}
.card-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}
.card-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-bottom: 12rpx;
}
.card-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  text-align: center;
  line-height: 1.4;
}
